# SmartSavdo Environment Configuration Example

# Server configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database (Optional - server defaults to resilient demo store if not connected)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smartsavdo
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=smartsavdo

# AI Provider API Keys (Optional - server provides smart Uzbek NLP rule engine if no key is configured)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...

# Client API URL
VITE_API_BASE_URL=http://localhost:5000/api
